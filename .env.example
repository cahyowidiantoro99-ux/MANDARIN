# Copy to .env; local DEMO only. Never use DEMO in production.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DEMO_MODE=true
CONTENT_MODE=source
SQLITE_PATH=./data/development.sqlite
