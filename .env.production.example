SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only required for the first production Leader account; store PASSWORD as a secret.
LEADER_EMAIL=
LEADER_PASSWORD=
